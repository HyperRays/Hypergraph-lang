.decl val_uedge(x: id, a: id, b: id)
.decl val_ann(x: id, p: id)             // payload of an edge-valued value
.decl val_struct(x: id, name: symbol)   // fallback for structs without a usable .decl
.decl val_arg(x: id, i: number, m: id)
