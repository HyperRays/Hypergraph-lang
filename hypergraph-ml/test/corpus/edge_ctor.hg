// 'Edge(...)' is the arrow's constructor spelling only when its sides are
// set expressions. Otherwise it names a struct, which the checker judges.
let a = Edge({1}, {2})
let b = Edge({1}, {2}, 5)
let c = Edge(x & y, z / w)
let d = Edge(5, {2})
let e = Edge({1}, 5)
let f = Edge({1})
let g = Edge({1}, {2}, 3, 4)
let h = Edge<Int>({1}, {2})
let i = Edge()
