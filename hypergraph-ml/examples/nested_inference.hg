// Independent groups of constraints exercise multi-parameter enum inference,
// aliases over distributive sets, and generic values shared across bindings.

enum Change<Before,After,Reason> {
  Added(After),
  Removed(Before, Reason),
  Replaced(Before, After),
}

struct ChangeBatch<Before,After,Reason> {
  addition: Change<Before,After,Reason>,
  removal: Change<Before,After,Reason>,
  replacement: Change<Before,After,Reason>,
}

// Each constructor reveals a different subset of the three parameters.
let addition = Change::Added("ready")
let removal = Change::Removed(404, "obsolete")
let replacement = Change::Replaced(200, "complete")

// Sharing one generic Change type across the fields recovers all parameters:
// Before = Int, After = String, Reason = String.
let changes = ChangeBatch(addition, removal, replacement)

struct Cell<Key,Value> {
  key: Key,
  value: Value,
}

alias Rows<Row> = Set<Row>

struct Page<Row> {
  rows: Rows<Row>,
  selected: Row,
}

let port = Cell("port", 8080)
let workers = Cell("workers", 4)
let cells = {port, workers}

// Row is inferred through both the Rows alias and the selected field.
let settings = Page(cells, port)

enum Delivery<Item,Failure> {
  Arrived(Item),
  Rejected(Failure),
}

struct DeliveryPair<Item,Failure> {
  success: Delivery<Item,Failure>,
  failure: Delivery<Item,Failure>,
}

let arrived = Delivery::Arrived(200)
let rejected = Delivery::Rejected("timeout")

// The two independently open constructor types meet here as
// Delivery<Int,String>.
let delivery = DeliveryPair(arrived, rejected)
