let small = {1, 2, 3}
let large = {2, 3, 4, 5}

let union = small | large
let intersection = small & large
let difference = large - small

// Mutability is declaration syntax, so it necessarily remains explicit.
let working: mut Set<Int> = {1, 2}
working |= {3, 4}
working &= {2, 3, 4}
working -= {3}

let left = {1} -> {2}
let right = {3} -> {4}
let combined_edge = left | right
