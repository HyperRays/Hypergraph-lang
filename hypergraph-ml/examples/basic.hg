struct Person {
    name: String,
    age: Int,
}

enum Relationship {
    Friend,
    Colleague(String),
}

alias SocialGraph = Graph<Person, Person, Relationship>

let alice = Person("Alice", 30)
let bob = Person("Bob", 28)
let friendship = {alice} <-[Relationship::Friend]-> {bob}
let network: mut SocialGraph = {friendship}
network |= {{alice} -[Relationship::Colleague("Research")]-> {bob}}

let visits: List<Person> = [alice, bob, alice]
let absent: Option<Person> = None
