alias Names<T> = Set<T>

struct Pair<A,B> {
  first: A,
  second: B,
}

enum Outcome<Value,Problem> {
  Success(Value),
  Failure(Problem),
}

struct Entry<Key,Value> {
  key: Key,
  value: Value,
}

struct Report<Value,Problem> {
  success: Outcome<Value,Problem>,
  failure: Outcome<Value,Problem>,
}

struct Directory<T> {
  names: Names<T>,
}

let inferred_pair = Pair(7, "seven")
let second_pair = Pair("eight", 8)

let success = Outcome::Success(42)
let failure = Outcome::Failure("not found")
let report = Report(success, failure)

let first_entry = Entry("answer", success)
let second_entry = Entry("missing", failure)
let entries = {
  first_entry,
  second_entry,
}

let names = {"Alice", "Bob", "Carol"}
let directory = Directory(names)
