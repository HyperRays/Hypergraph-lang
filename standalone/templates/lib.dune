(library
 (name hypergraph)
 (modules Ast Parser Lexer Validate Driver Lean_bridge Solver Types Check Value Program)
 (libraries yojson zarith threads)
 (foreign_stubs
  (language c)
  (names lean_stubs)
  (flags (:standard -I%{env:LEAN_PREFIX=}/include)))
 (c_library_flags
  -Wl,-force_load,%{env:LEAN_RUNTIME_ARCHIVE=}
  %{env:LEAN_PREFIX=}/lib/lean/libleancpp.a
  %{env:LEAN_PREFIX=}/lib/lean/libInit.a
  %{env:LEAN_PREFIX=}/lib/lean/libStd.a
  %{env:LEAN_PREFIX=}/lib/lean/libLean.a
  %{env:LEAN_PREFIX=}/lib/lean/libleanrt.a
  %{env:LEAN_PREFIX=}/lib/lean/libLake.a
  %{env:GMP_STATIC_ARCHIVE=}
  %{env:LIBUV_STATIC_ARCHIVE=}
  %{env:SSL_STATIC_ARCHIVE=}
  %{env:CRYPTO_STATIC_ARCHIVE=}
  -lc++
  -lz
  -framework CoreFoundation
  -framework Security
  -Wl,-dead_strip
  -Wl,-dead_strip_dylibs)
 (preprocess (pps ppx_deriving.ord ppx_deriving.eq)))
(ocamllex lexer)
(menhir
 (modules parser)
 (flags --explain --strict))

